{
  "name": "collab-docs-core",
  "private": true,
  "version": "0.2.0",
  "workspaces": [
    "packages/client",
    "packages/server",
    "packages/shared"
  ],
  "scripts": {
    "run": "bash ./run.sh",
    "dev:server": "npm run dev --workspace @collab/server",
    "dev:client": "npm run dev --workspace @collab/client",
    "check:shared": "npm run check --workspace @collab/shared",
    "check:client": "npm run check --workspace @collab/client",
    "check:server": "npm run check --workspace @collab/server",
    "check": "npm run check:shared && npm run check:client && npm run check:server",
    "test:client": "npm run test --workspace @collab/client",
    "test:server": "npm run test --workspace @collab/server",
    "test": "npm run test:server && npm run test:client",
    "test:e2e": "npm run test:e2e --workspace @collab/client"
  }
}
